PORT=3001
# Optional locally: omit DATABASE_URL to use embedded PostgreSQL in .local/postgres.
# Required on Render; the Blueprint connects the managed database automatically.
DATABASE_URL=
# Server-only. Never use a VITE_ prefix for secrets.
EXA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=high
# Required locally and in production. Keep these values private.
APP_PASSWORD=
# Random session-signing key, at least 32 characters; independent of the password.
SESSION_SECRET=
# Render's RENDER_EXTERNAL_URL is used automatically; set for a custom domain.
APP_ORIGIN=
# Optional Google Docs export, using an OAuth refresh token with drive.file scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# OAuth callbacks use APP_ORIGIN (or Render's external URL); no manual refresh token needed.
# Local: path to a headless LibreOffice executable. Docker includes it on Render.
LIBREOFFICE_BIN=soffice
# Optional fontconfig file for PDF rendering with locally installed template fonts.
RESUME_FONTCONFIG=

# PDF-native resume editing (install server/pdf/requirements.txt in this runtime)
RESUME_PDF_PYTHON=python3
