{
  "name": "personal-job-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/index.ts server/worker.ts server/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "build": "npm run typecheck && vite build && npm run build:server",
    "start": "NODE_ENV=production node dist/server/index.mjs",
    "worker": "tsx server/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@radix-ui/themes": "^3.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.2.0",
    "docx": "^9.15.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "exa-js": "^2.28.0",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "googleapis": "^189.0.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.53.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
